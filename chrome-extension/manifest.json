{
  "manifest_version": 3,
  "name": "ChatGPT Auto Temporary Router",
  "version": "1.6.0",
  "description": "Routes local demo prompts into a fresh ChatGPT Temporary Chat.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8788/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Temporary Chat Demo"
  }
}
