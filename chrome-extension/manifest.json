{
  "manifest_version": 3,
  "name": "ChatGPT Auto Temporary Router",
  "version": "1.4.0",
  "description": "Opens a new Temporary Chat and fills a demo prompt.",
  "permissions": ["tabs"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Temporary Chat Demo"
  }
}
