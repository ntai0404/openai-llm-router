# Upstream OpenAI-compatible Responses API.
UPSTREAM_BASE_URL=https://api.openai.com

# Secret used by this router to call the official API.
OPENAI_API_KEY=sk-REPLACE_ME

# Secret Codex must send to this router as Authorization: Bearer ...
# Generate a long random value. Do not reuse OPENAI_API_KEY.
ROUTER_API_KEY=replace-with-a-long-random-router-token

HOST=127.0.0.1
PORT=8787
MAX_BODY_BYTES=10485760
